---
// src/components/VoxelField.astro — pixelated quantised-noise backdrop.
// Runtime and every tunable live in ../lib/voxel-field.ts; the tuning panel
// (../lib/voxel-debug.ts) mounts in dev builds or with ?debug in the URL.
// Decorative only: aria-hidden, pauses off-screen, static single frame under
// reduced-motion. Default: fills a position:relative parent. `fixed`:
// viewport-wide page backdrop behind all content (z-index -1; solid-background
// panels occlude it).
interface Props { fixed?: boolean }
const { fixed = false } = Astro.props;
---
<canvas class:list={['voxel-field', { 'voxel-field--fixed': fixed }]} aria-hidden="true"></canvas>

<style>
  .voxel-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
    /* renderer reads this computed color → bands follow the theme */
    color: var(--ink);
  }
  .voxel-field--fixed {
    position: fixed;
    z-index: -1;
  }
</style>

<script>
  import { mountAll } from '../lib/voxel-field';
  mountAll();
</script>
