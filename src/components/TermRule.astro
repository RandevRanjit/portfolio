---
// src/components/TermRule.astro — hairline section divider.
// variant="full" (default): ink hairline.   variant="light": muted hairline.
const { variant = 'full' } = Astro.props as { variant?: 'full' | 'light' };
---
<hr class:list={['rule', `rule--${variant}`]} aria-hidden="true" />
<style>
  .rule { border: 0; border-top: 1px solid var(--ink); margin: 0; }
  .rule--light { border-top-color: var(--line); }
</style>
