---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FieldsPanel from '../components/FieldsPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { withBase } from '../lib/url';
import { getCollection } from 'astro:content';

const work = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Portfolio" current={undefined}>
  <Hero />

  <section class="wrap reveal" style="padding-block:1.5rem 2rem;">
    <p class="section-num">01 / FIELDS</p>
    <FieldsPanel />
  </section>

  <section class="reveal" style="padding-block:2rem 3rem;">
    <p class="section-num wrap">02 / ALL WORK</p>
    <div class="marquee">
      <ul class="marquee__track" aria-label="All projects">
        {work.map((p) => (
          <li class="marquee__item">
            <ProjectCard num={String(p.data.order).padStart(2, '0')} slug={p.id}
              title={p.data.title} tagline={p.data.tagline} stack={p.data.stack}
              repoKind={p.data.repo.kind} />
          </li>
        ))}
      </ul>
    </div>
    <p class="wrap" style="margin-top:1.5rem;"><a href={withBase('quant')}>See all work by field →</a></p>
  </section>
</BaseLayout>
<script>
  // Marquee runtime — the track is a ring of cards. It is translated left by
  // `offset`; once the leading card has fully left the viewport it is moved to
  // the END of the track and `offset` drops by one stride. Nothing is
  // duplicated and nothing can run out: the DOM itself is the loop, and the
  // track never grows beyond one set of cards (cloned only when the window is
  // wider than the whole set), so no engine has to rasterise a huge layer —
  // the CSS-animation and scrollLeft versions both died mid-loop in WebKit.
  const SPEED = 36; // px/s

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const noHover = matchMedia('(hover: none)');

  document.querySelectorAll<HTMLElement>('.marquee').forEach((m) => {
    const found = m.querySelector<HTMLElement>('.marquee__track');
    if (!found || found.children.length < 2) return;
    const track: HTMLElement = found;

    let raf = 0, last = 0, offset = 0;
    let hovered = false, focused = false, inView = false;
    const allowed = () => !reduced.matches && !noHover.matches;
    const live = () => m.classList.contains('marquee--live');
    const first = () => track.firstElementChild as HTMLElement;
    const stride = () => (track.children[1] as HTMLElement).offsetLeft - first().offsetLeft;
    const place = () => { track.style.transform = `translateX(${-offset}px)`; };
    // right edge of the last card — NOT track.offsetWidth: WebKit sizes a
    // max-content flex container from the cards' ASCII-art intrinsic width,
    // ~5× the real row (that blank tail was the old "cards run out" bug)
    const extent = () => {
      const l = track.lastElementChild as HTMLElement;
      return l.offsetLeft + l.offsetWidth;
    };

    // The ring must span the viewport plus one recycled card. Only an
    // ultrawide window is wider than the whole set; clone the set then.
    function cover() {
      let guard = 0;
      while (extent() < m.clientWidth + 2 * stride() && guard++ < 3) {
        for (const li of Array.from(track.children)) {
          const c = li.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.inert = true;
          track.appendChild(c);
        }
      }
    }

    function step(now: number) {
      raf = 0;
      if (hovered || focused || !inView || !allowed()) return;
      const dt = Math.min(now - last, 100); // clamp background-tab jumps
      last = now;
      offset += SPEED * dt / 1000;
      // recycle every card that has fully scrolled off the left edge
      for (let s = stride(); s > 0 && offset >= s; s = stride()) {
        offset -= s;
        track.appendChild(first());
      }
      place();
      raf = requestAnimationFrame(step);
    }
    function schedule() {
      if (raf || hovered || focused || !inView || !allowed()) return;
      m.classList.add('marquee--live');
      cover();
      last = performance.now();
      raf = requestAnimationFrame(step);
    }
    // reduced-motion / touch: a plain swipeable row, no JS motion
    function sync() {
      if (allowed()) { schedule(); return; }
      m.classList.remove('marquee--live');
      offset = 0;
      place();
    }

    m.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovered = true; });
    m.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovered = false; schedule(); } });
    m.addEventListener('focusin', (e) => {
      focused = true;
      const item = (e.target as HTMLElement).closest<HTMLElement>('.marquee__item');
      if (!item || !live()) return;
      // rotate the ring so the focused card leads, fully in view
      let guard = track.children.length;
      while (first() !== item && guard-- > 0) track.appendChild(first());
      offset = 0;
      place();
      m.scrollLeft = 0; // undo the browser's own scroll-into-view on the clipped box
    });
    m.addEventListener('focusout', () => { focused = false; schedule(); });

    new IntersectionObserver((entries) => {
      entries.forEach((en) => { inView = en.isIntersecting; schedule(); });
    }, { threshold: 0.05 }).observe(m);
    new ResizeObserver(() => { if (live()) cover(); }).observe(m);

    reduced.addEventListener('change', sync);
    noHover.addEventListener('change', sync);
  });
</script>
<style>
  /* full-bleed auto-scrolling marquee — a ring of cards translated by the
     runtime above. Without the runtime (touch / reduced-motion) it is a plain
     swipeable row. Hover/focus pause in JS. */
  .marquee { overflow-x: auto; scrollbar-width: none; }
  .marquee::-webkit-scrollbar { display: none; }
  .marquee--live { overflow: hidden; }
  .marquee__track {
    display: flex; align-items: stretch; gap: 1.25rem; width: max-content;
    list-style: none; margin: 0; padding: .5rem 0 .75rem;
  }
  /* explicit width (not just flex-basis) so the card's ASCII art can't inflate
     the row's intrinsic width in WebKit */
  .marquee__item { flex: 0 0 auto; width: clamp(17rem, 26vw, 21rem); min-width: 0; display: flex; }
</style>
